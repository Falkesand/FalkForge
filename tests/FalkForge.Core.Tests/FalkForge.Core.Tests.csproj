<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Deliberate opt-in to the .NET 10 ML-DSA (FIPS 204) API for PQ-hybrid manifest signing —
         see the rationale comment in src/FalkForge.Core/FalkForge.Core.csproj. -->
    <NoWarn>$(NoWarn);SYSLIB5006</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <!-- SPDX conformance checking only — see Sbom/SpdxSchemaConformanceTests.cs. -->
    <PackageReference Include="JsonSchema.Net" />
    <!-- Roslyn in-memory compile probe for DialogCustomizationSuppressDialogGateTests — proves
         SuppressDialog's [Obsolete(error: true)] is a genuine compile-time gate, not just a
         warning. Same package + technique as EmittedSourceCompilesTests.cs. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" />
  </ItemGroup>
  <ItemGroup>
    <!-- The official SPDX 2.3 JSON schema, vendored verbatim so CI keeps checking emitted documents
         against the spec's own machine-readable definition rather than against hand-read prose.
         Provenance is recorded in Assets/README.md; do not hand-edit the schema. -->
    <None Include="Assets\spdx-2.3-schema.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\FalkForge.Core\FalkForge.Core.csproj" />
    <ProjectReference Include="..\..\src\FalkForge.Testing\FalkForge.Testing.csproj" />
  </ItemGroup>
</Project>
