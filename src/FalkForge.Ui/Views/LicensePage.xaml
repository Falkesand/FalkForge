<UserControl x:Class="FalkForge.Ui.Views.LicensePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <!-- Banner — white surface, 72 px, subtle bottom divider -->
        <Border DockPanel.Dock="Top"
                Height="72"
                Background="{DynamicResource SurfaceBrush}"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource BorderBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}"       Style="{DynamicResource BannerTitle}" />
                    <TextBlock Text="{Binding Description}" Style="{DynamicResource BannerSubtitle}" />
                </StackPanel>

                <!-- Icon — rounded accent tile, 44×44 -->
                <Border Grid.Column="1"
                        Width="44" Height="44"
                        CornerRadius="6"
                        Margin="0,0,14,0"
                        ClipToBounds="True">
                    <Grid>
                        <Rectangle Fill="{DynamicResource BannerIconBrush}" />
                        <Image Source="{DynamicResource BannerIconImage}" Stretch="Fill" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Content.
             A Grid, not a StackPanel, and the licence text has no fixed height: the checkbox is
             the only way past this page, so it gets its space first and the text box takes what
             is left. With a StackPanel and a 210px text box the two together wanted more room
             than the page is given, and WPF's layout clip cut the checkbox away entirely — it
             was still in the automation tree, and a person saw blank space where it should be. -->
        <Grid Margin="24,18,20,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="60" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBox Grid.Row="0"
                     Text="{Binding LicenseText, Mode=OneWay}"
                     IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto"
                     TextWrapping="Wrap"
                     Margin="0,0,0,12" />

            <CheckBox Grid.Row="1"
                      Content="I accept the license agreement"
                      IsChecked="{Binding IsAccepted}" />
        </Grid>
    </DockPanel>
</UserControl>
