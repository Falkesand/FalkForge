<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The properties in this block are supplied by the repository's own root
         Directory.Build.props when this file is compiled as part of FalkForge.slnx. The tools/src
         tree this file ships in stops that upward walk deliberately (a consumer's own repository
         root must never reshape the engine's trust-critical build), so the shipped copy carries
         them explicitly instead. This is one of the three differences from the repository original;
         see FalkForge.Engine.Sources.csproj for the other two. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- The rebuilt binary must report the release its sources came from. Without this the SDK default
         1.0.0 wins, and the bundle compiler's runtime-version check (BDL038) ranks it above every
         FalkForge prerelease. The token is rewritten to the real version when the package is packed. -->
    <Version>$(FalkForgePackageVersion)</Version>
    <Deterministic>true</Deterministic>

    <OutputType>Exe</OutputType>
    <RootNamespace>FalkForge.Engine</RootNamespace>
    <Description>NativeAOT bundle engine for FalkForge</Description>
    <PublishAot>true</PublishAot>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>
    <!-- Required for P/Invoke interop with native Windows APIs (MSI, Restart Manager) -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- comctl32 v6 app manifest — required for TaskDialogIndirect (pre-UI progress dialog) -->
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Once restored, this project lives under the machine-wide global NuGet packages folder
         (%USERPROFILE%\.nuget\packages), user-writable and shared by every project on the
         machine. See FalkForge.Engine.Sources/build/FalkForge.Engine.Sources.props. NuGet never
         re-verifies an already-extracted package, so the SDK's default **/*.cs glob would compile
         in any .cs file dropped into that directory after the fact. Disabled here; the explicit,
         pack-time-generated Compile list below replaces it with an exact file list instead. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <!-- The repository original references these as sibling ProjectReference items. A consumer of
         this package has no sibling project to point at, and the engine's whole dependency closure
         already ships on NuGet as libraries, so these are PackageReference at this very package's
         own version instead. Bracketed (exact) version: a bare version is a NuGet FLOOR, not a
         pin. "1.2.3" resolves to >=1.2.3, so a higher version published later, malicious or not,
         would satisfy it just as well. -->
    <PackageReference Include="FalkForge.Engine.Protocol" Version="[$(FalkForgePackageVersion)]" />
    <PackageReference Include="FalkForge.Platform.Windows" Version="[$(FalkForgePackageVersion)]" />
    <PackageReference Include="FalkForge.Compiler.Msi" Version="[$(FalkForgePackageVersion)]" />
  </ItemGroup>
  <ItemGroup>
    <!-- Populated at THIS package's pack time with the real, enumerated file list. See
         _FalkForgeInsertExplicitCompileItems in FalkForge.Engine.Sources.csproj, so the list can
         never drift from what was actually packed, and a file planted here after extraction is on
         disk but not in this list. -->
    <!--FALKFORGE_COMPILE_ITEMS-->
  </ItemGroup>

  <!-- Build-time injection of the trusted publisher-key set into a generated BakedTrustedKeys constant. -->
  <Import Project="TrustedKeys.targets" />
  <!-- Explains a Visual Studio toolchain bug that otherwise looks like a missing NativeAOT linker. -->
  <Import Project="NativeAotPublishDiagnostics.targets" />
</Project>
