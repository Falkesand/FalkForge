<?xml version="1.0" encoding="utf-8"?>
<!-- Restricts where this build's packages can come from. Two things this file does, and one it
     cannot.

     clear only clears the packageSources SECTION of THIS file. A consumer's user-level and
     machine-level NuGet.config still merge in for every OTHER section: fallbackPackageFolders,
     globalPackagesFolder, disabledPackageSources, trustedSigners, packageSourceCredentials. None
     of those can be overridden by a config file shipped inside a package. A consumer whose
     environment sets NUGET_PACKAGES, or whose own config carries a fallbackPackageFolders entry,
     can still have a package satisfied from a folder this file never named, and NuGet does not
     re-verify a package already sitting in a folder like that.

     packageSourceMapping below closes the narrower gap this file CAN close: even if a consumer's
     build adds another source through the CLI source option or RestoreAdditionalProjectSources,
     that source cannot supply any package id unless this file maps it there, and here nothing but
     nuget.org is mapped to anything.

     signatureValidationMode=require plus trustedSigners was considered and left out, not
     forgotten. Measured 2026-09-18 with `dotnet nuget verify` against a live nuget.org package:
     nuget.org repository-signs every package on push, so a real consumer restoring FalkForge.*
     from nuget.org would pass. But this repository's own packaging test builds the packaged
     engine against locally packed, unsigned sibling packages, see
     PackagedSource_RestoresAndBuildsAgainstItsRealSiblingPackages in EngineSourcePackageTests.cs,
     and "require" mode rejects an unsigned package outright; no trustedSigners entry accepts "no
     signature". Turning it on here would fail the packaged engine's own pre-release build/test
     loop before nuget.org ever saw the package, not just a hypothetical attack. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
