<?xml version="1.0" encoding="utf-8"?>
<!-- Clears the source list so a consumer's own feed configuration cannot redirect this restore
     to a source carrying a tampered copy of the same package id/version. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
