<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Packaging-only project: no consumable assembly. It carries the SOURCE of the two
         executables that must be rebuilt per publisher, because the trusted-key fingerprint is
         baked in at compile time and a prebuilt binary therefore cannot carry a publisher's pin.
         Everything else the engine needs is already on NuGet as a library, so this package is
         under a megabyte. -->
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable Condition="'$(FalkForgePackEngine)' != 'false' and '$(FalkForgePackEngineSources)' != 'false'">true</IsPackable>
    <PackageId>FalkForge.Engine.Sources</PackageId>
    <Description>FalkForge bundle engine and elevation companion, as source. The bundle compiler rebuilds both with the publisher's key fingerprint baked in, which is what lets a per-machine install verify who authored the bundle. Restored automatically by the FalkForge SDK and meta-package.</Description>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <!-- Required for the explicitly included .editorconfig policy file. -->
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <!-- The .cs files are packed straight from the originals. They are never copied into this
         directory, so the shipped source and the built source cannot drift. -->
    <None Include="..\FalkForge.Engine\**\*.cs"
          Exclude="..\FalkForge.Engine\obj\**;..\FalkForge.Engine\bin\**"
          Pack="true" PackagePath="tools/src/FalkForge.Engine" Visible="false" />
    <None Include="..\FalkForge.Engine\app.manifest;..\FalkForge.Engine\TrustedKeys.targets;..\FalkForge.Engine\NativeAotPublishDiagnostics.targets"
          Pack="true" PackagePath="tools/src/FalkForge.Engine" Visible="false" />
    <None Include="..\FalkForge.Engine.Elevation\**\*.cs"
          Exclude="..\FalkForge.Engine.Elevation\obj\**;..\FalkForge.Engine.Elevation\bin\**"
          Pack="true" PackagePath="tools/src/FalkForge.Engine.Elevation" Visible="false" />
    <None Include="..\FalkForge.Engine.Elevation\app.manifest"
          Pack="true" PackagePath="tools/src/FalkForge.Engine.Elevation" Visible="false" />

    <!-- The stopper files are authored here, not copied. The two rewritten csproj files are also
         authored here as templates carrying the literal placeholder $(FalkForgePackageVersion) in
         their PackageReference Version attributes — see the substitution target below for why they
         are packed from a generated copy rather than directly. -->
    <None Include="src\Directory.Build.props;src\Directory.Build.targets;src\Directory.Packages.props;src\NuGet.config"
          Pack="true" PackagePath="tools/src" />

    <!-- Ship the same root analyzer policy used to validate these sources. -->
    <None Include="..\..\.editorconfig" Pack="true" PackagePath="tools/src/.editorconfig" Visible="false" />
    <None Include="..\..\global.json" Pack="true" PackagePath="tools/src/global.json" Visible="false" />

    <None Include="build\FalkForge.Engine.Sources.props" Pack="true" PackagePath="build" />
    <None Include="build\FalkForge.Engine.Sources.props" Pack="true" PackagePath="buildTransitive" />
  </ItemGroup>

  <!-- The two rewritten csproj templates carry the literal text "$(FalkForgePackageVersion)" in
       their PackageReference Version attributes. That is not an MSBuild property reference to be
       evaluated at a CONSUMER's build time — the packaged tree's own Directory.Build.props stopper
       means no such property would exist there. It is a placeholder token, substituted for real
       here, at THIS project's pack time, with THIS project's own resolved $(PackageVersion) — the
       exact sibling package version that ships alongside it. The substituted copy is packed;
       the checked-in template never is. -->
  <UsingTask TaskName="_FalkForgeSubstitutePackageVersion"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <SourcePath ParameterType="System.String" Required="true" />
      <DestinationPath ParameterType="System.String" Required="true" />
      <PackageVersionValue ParameterType="System.String" Required="true" />
      <PlaceholderToken ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Code Type="Fragment" Language="cs">
<![CDATA[
var text = File.ReadAllText(SourcePath);
var substituted = text.Replace(PlaceholderToken, PackageVersionValue);
var dir = Path.GetDirectoryName(DestinationPath);
if (!string.IsNullOrEmpty(dir) && !Directory.Exists(dir))
{
    Directory.CreateDirectory(dir);
}
File.WriteAllText(DestinationPath, substituted);
]]>
      </Code>
    </Task>
  </UsingTask>

  <!-- Second pass over the same generated csproj copies: replaces the FALKFORGE_COMPILE_ITEMS
       marker with an explicit, enumerated <Compile Include="..."/> list built from the real .cs
       files under the corresponding repository source directory. These are the same files the
       None ItemGroup above packs, computed the same way (Path.GetRelativePath from that
       directory, excluding obj/bin), so the compiled set and the packed set cannot drift apart.
       Paired with EnableDefaultCompileItems=false in the templates, a .cs file that later appears
       in a consumer's extracted copy of this package (the global NuGet packages folder is
       user-writable and shared machine-wide; NuGet never re-verifies an already-extracted
       package) is on disk but not in this list, so it does not compile in. -->
  <UsingTask TaskName="_FalkForgeInsertExplicitCompileItems"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <SourceDir ParameterType="System.String" Required="true" />
      <ProjectFileToEdit ParameterType="System.String" Required="true" />
      <PlaceholderToken ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Text" />
      <Code Type="Fragment" Language="cs">
<![CDATA[
// RoslynCodeTaskFactory compiles this fragment against the .NET Framework reference set
// carried by Microsoft.Build.Tasks.Core.dll, where System.IO.Path has no GetRelativePath
// overload (it is a .NET Core / .NET Standard 2.1 addition). SourceDir is the root passed
// to Directory.EnumerateFiles below, so every returned path is guaranteed to start with it;
// stripping that known prefix stands in for GetRelativePath without needing it.
var sourceRootFull = Path.GetFullPath(SourceDir);
if (!sourceRootFull.EndsWith(Path.DirectorySeparatorChar.ToString(), StringComparison.Ordinal))
{
    sourceRootFull += Path.DirectorySeparatorChar;
}

string RelativeToSourceRoot(string fullPath) => Path.GetFullPath(fullPath).Substring(sourceRootFull.Length);

var files = Directory.EnumerateFiles(SourceDir, "*.cs", SearchOption.AllDirectories)
    .Where(f =>
    {
        var rel = RelativeToSourceRoot(f).Replace('\\', '/');
        return !rel.StartsWith("obj/", StringComparison.OrdinalIgnoreCase)
            && !rel.StartsWith("bin/", StringComparison.OrdinalIgnoreCase);
    })
    .OrderBy(f => f, StringComparer.Ordinal)
    .ToList();

var itemLines = new StringBuilder();
foreach (var file in files)
{
    var relative = RelativeToSourceRoot(file)
        .Replace("&", "&amp;").Replace("\"", "&quot;").Replace("<", "&lt;").Replace(">", "&gt;");
    itemLines.Append("    <Compile Include=\"").Append(relative).Append("\" />").Append(Environment.NewLine);
}

var text = File.ReadAllText(ProjectFileToEdit);
var substituted = text.Replace(PlaceholderToken, itemLines.ToString().TrimEnd());
File.WriteAllText(ProjectFileToEdit, substituted);
]]>
      </Code>
    </Task>
  </UsingTask>

  <!-- _GetPackageFiles is the NuGet SDK target that gathers @(None) items with Pack=true into the
       nuspec; running before it lets these dynamically-added items be seen the same way as the
       static ones above. -->
  <Target Name="_FalkForgeGenerateVersionedProjectFiles" BeforeTargets="_GetPackageFiles">
    <PropertyGroup>
      <_FalkForgePackagedRoot>$([System.IO.Path]::GetFullPath('$(IntermediateOutputPath)PackagedSrc'))</_FalkForgePackagedRoot>
      <FalkForgeSourceLockFeed Condition="'$(FalkForgeSourceLockFeed)' == ''">$(PackageOutputPath)</FalkForgeSourceLockFeed>
      <FalkForgeSourceLockFeed Condition="'$(MSBuildStartupDirectory)' != ''">$([System.IO.Path]::GetFullPath('$(FalkForgeSourceLockFeed)', '$(MSBuildStartupDirectory)'))</FalkForgeSourceLockFeed>
      <FalkForgeSourceLockFeed Condition="'$(MSBuildStartupDirectory)' == ''">$([System.IO.Path]::GetFullPath('$(FalkForgeSourceLockFeed)', '$(MSBuildProjectDirectory)'))</FalkForgeSourceLockFeed>
      <_FalkForgeEngineCsprojOut>$(_FalkForgePackagedRoot)\FalkForge.Engine\FalkForge.Engine.csproj</_FalkForgeEngineCsprojOut>
      <_FalkForgeElevationCsprojOut>$(_FalkForgePackagedRoot)\FalkForge.Engine.Elevation\FalkForge.Engine.Elevation.csproj</_FalkForgeElevationCsprojOut>
    </PropertyGroup>

    <_FalkForgeSubstitutePackageVersion
        SourcePath="src\FalkForge.Engine\FalkForge.Engine.csproj"
        DestinationPath="$(_FalkForgeEngineCsprojOut)"
        PackageVersionValue="$(PackageVersion)"
        PlaceholderToken="%24(FalkForgePackageVersion)" />
    <_FalkForgeSubstitutePackageVersion
        SourcePath="src\FalkForge.Engine.Elevation\FalkForge.Engine.Elevation.csproj"
        DestinationPath="$(_FalkForgeElevationCsprojOut)"
        PackageVersionValue="$(PackageVersion)"
        PlaceholderToken="%24(FalkForgePackageVersion)" />

    <!-- Same source directories the None ItemGroup above packs from: ..\FalkForge.Engine and
         ..\FalkForge.Engine.Elevation, siblings of this project, not the packaged template folder
         under src\ which holds only the rewritten csproj. -->
    <_FalkForgeInsertExplicitCompileItems
        SourceDir="..\FalkForge.Engine"
        ProjectFileToEdit="$(_FalkForgeEngineCsprojOut)"
        PlaceholderToken="&lt;!--FALKFORGE_COMPILE_ITEMS--&gt;" />
    <_FalkForgeInsertExplicitCompileItems
        SourceDir="..\FalkForge.Engine.Elevation"
        ProjectFileToEdit="$(_FalkForgeElevationCsprojOut)"
        PlaceholderToken="&lt;!--FALKFORGE_COMPILE_ITEMS--&gt;" />

    <Copy SourceFiles="src\Directory.Build.props;src\Directory.Build.targets;src\Directory.Packages.props;..\..\global.json"
          DestinationFolder="$(_FalkForgePackagedRoot)" />
    <Copy SourceFiles="..\FalkForge.Engine\TrustedKeys.targets;..\FalkForge.Engine\NativeAotPublishDiagnostics.targets;..\FalkForge.Engine\app.manifest"
          DestinationFolder="$(_FalkForgePackagedRoot)\FalkForge.Engine" />
    <Copy SourceFiles="..\FalkForge.Engine.Elevation\app.manifest"
          DestinationFolder="$(_FalkForgePackagedRoot)\FalkForge.Engine.Elevation" />
    <Exec Command="pwsh -NoProfile -File &quot;$(MSBuildThisFileDirectory)..\..\scripts\Generate-EngineSourceLocks.ps1&quot; -SourceRoot &quot;$(_FalkForgePackagedRoot)&quot; -Feed &quot;$(FalkForgeSourceLockFeed)&quot; -RepositoryRoot &quot;$(MSBuildThisFileDirectory)..\..&quot;" />

    <ItemGroup>
      <None Include="$(_FalkForgePackagedRoot)\FalkForge.Engine\packages.lock.json" Pack="true" PackagePath="tools/src/FalkForge.Engine" />
      <None Include="$(_FalkForgePackagedRoot)\FalkForge.Engine.Elevation\packages.lock.json" Pack="true" PackagePath="tools/src/FalkForge.Engine.Elevation" />
      <None Include="$(_FalkForgeEngineCsprojOut)" Pack="true" PackagePath="tools/src/FalkForge.Engine" />
      <None Include="$(_FalkForgeElevationCsprojOut)" Pack="true" PackagePath="tools/src/FalkForge.Engine.Elevation" />
      <FileWrites Include="$(_FalkForgeEngineCsprojOut);$(_FalkForgeElevationCsprojOut)" />
    </ItemGroup>
  </Target>
</Project>
