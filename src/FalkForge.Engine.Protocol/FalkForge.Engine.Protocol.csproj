<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>FalkForge.Engine.Protocol</RootNamespace>
    <Description>IPC protocol types and serialization for FalkForge engine</Description>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Required by LibraryImport source-generation for NativePipeMethods.GetNamedPipeServerProcessId.
         Verified 2026-07-10: removing this fails the build with SYSLIB1062 ("LibraryImportAttribute
         requires unsafe code") and CS0227 in the generated LibraryImports.g.cs. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Deliberate opt-in to the .NET 10 ML-DSA (FIPS 204) API for PQ-hybrid manifest signing —
         see the rationale comment in FalkForge.Core.csproj. AOT-safe (probe-verified NativeAOT). -->
    <NoWarn>$(NoWarn);SYSLIB5006</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- FalkForge.Engine and FalkForge.Engine.Elevation are shipping assemblies, not test
         projects. Both are granted internals access only because production code in each needs
         other internal members here. Neither should ever come to depend on
         PipeClient.PipeOwnerSidOverride (Transport/PipeClient.cs) — an internal test-only seam
         that replaces the pipe-owner identity check ConnectAsync relies on to refuse an
         unrecognised peer. A production caller that sets it would disable that check with no
         compiler complaint. #if DEBUG cannot guard the property instead: CI's build-and-test gate
         runs `dotnet test FalkForge.slnx -c Release` (.github/workflows/ci.yml), and
         PipeOwnerVerificationTests.cs sets the property directly from ordinary [Fact] methods, so
         a DEBUG-only property would fail that Release test build. Do not add another shipping
         assembly to this list without the same check. -->
    <InternalsVisibleTo Include="FalkForge.Engine.Protocol.Tests" />
    <InternalsVisibleTo Include="FalkForge.Engine" />
    <InternalsVisibleTo Include="FalkForge.Engine.Tests" />
    <InternalsVisibleTo Include="FalkForge.Engine.Elevation" />
    <InternalsVisibleTo Include="FalkForge.Engine.Elevation.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- Octopus.Octodiff powers DeltaApplicator (install-time delta reconstruction). It lives here,
         not in FalkForge.Engine, because DeltaApplicator sits beside BundleReader in this AOT-safe
         assembly and reuses BundleReader's payload extraction. Stream-based, no reflection. -->
    <PackageReference Include="Octopus.Octodiff" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\FalkForge.Core\FalkForge.Core.csproj" />
  </ItemGroup>
</Project>
